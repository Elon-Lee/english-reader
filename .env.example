# Keep this file safe to commit. Put real credentials only in a local .env file.
# SaaS is deliberately off until PostgreSQL has been provisioned and migrated.
SHIYUE_SAAS_ENABLED=0
DATABASE_URL=postgresql://shiyue:change-me@127.0.0.1:5432/shiyue
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:8765
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BOOTSTRAP_ADMIN_EMAIL=
# Required only for the first bootstrap; remove it from the environment after
# the administrator has been created.
BOOTSTRAP_ADMIN_PASSWORD=
MEDIA_ROOT=/absolute/path/to/books

# SaaS platform-level dictionary/AI provider configuration. Do not use the
# legacy .dioco.local.json for multi-user SaaS traffic.
SHIYUE_DIOCO_EMAIL=
SHIYUE_DIOCO_TOKEN=

# Filesystem-backed backup and deletion maintenance paths. The default tools
# write under .local; configure an external backup location for production.
SAAS_BACKUP_ROOT=/absolute/path/to/saas-backups

# Set only for a controlled local bootstrap. Production upgrades should use
# `python3 tools/saas_migrate.py --migrate` before enabling the service.
SHIYUE_SAAS_AUTO_MIGRATE=0
