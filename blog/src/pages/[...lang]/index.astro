---
import { allLocales } from '@/config'
import { categories } from '@/categories'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import PostCard from '@/components/PostCard.astro'
import { getPosts } from '@/utils/content'
export function getStaticPaths() { return allLocales.map(lang => ({ params: { lang: getLangRouteParam(lang) } })) }
const posts = await getPosts(getLangFromLocale(Astro.currentLocale))
const featured = posts.find(post => post.data.abbrlink === 'ai-vocabulary-cards') ?? posts[0]
const latest = posts.filter(post => post.data.category !== 'english-tools').slice(0, 6)
const englishPosts = posts.filter(post => post.data.category === 'english-tools')
---
<Layout>
  <section class="journal-hero">
    <div class="hero-copy"><p class="eyebrow"><span /> AI 英语工具 · 方法与练习</p><h1>借一束 AI 微光，<br />把英语<em>用起来。</em></h1><p class="hero-description">从一张词汇卡，到一场英语对话。<br />整理 AI 辅助听、说、读、写的方法，让每次练习都有下一步。</p><div class="hero-actions"><a class="paper-button" href="/categories/english-tools/">翻开英语工具箱 ↗</a><a href="/archives/">文章归档 →</a></div><p class="hero-footnote">先自己尝试，再借助工具，最后留下自己的表达。</p></div>
    <div class="hero-art"><img src="/images/english-learning.svg" alt="写有英语单词的学习笔记、词汇卡与对话气泡" width="480" height="360" /><span class="art-caption">ENGLISH, SMALL STEPS & AI</span></div>
  </section>
  <section class="category-section" aria-labelledby="category-heading"><div class="section-heading"><div><p class="eyebrow">从英语练习出发，理解与使用 AI</p><h2 id="category-heading">给学习准备四个书签</h2></div><span class="section-note">LEARN / READ / PRACTICE</span></div><div class="category-grid">{categories.map((category, index) => <a class="category-card" href={`/categories/${category.slug}/`}><div><span class="category-number">0{index + 1}</span><span class="category-symbol" aria-hidden="true">{category.symbol}</span></div><h3>{category.title}</h3><p>{category.description}</p><span class="category-count">{posts.filter(post => post.data.category === category.slug).length} 篇文字 <span aria-hidden="true">↗</span></span></a>)}</div></section>
  <div class="journal-columns"><div>
    {featured && <section class="featured-section" aria-labelledby="featured-heading"><div class="section-heading"><h2 id="featured-heading">从一个小练习开始</h2><span class="section-note">ENGLISH TOOLKIT</span></div><PostCard post={featured} featured /></section>}
    <section class="featured-section" aria-labelledby="english-heading"><div class="section-heading"><div><p class="eyebrow">把方法变成一次实际练习</p><h2 id="english-heading">AI 英语工具箱</h2></div><a class="text-link" href="/categories/english-tools/">全部方法 →</a></div><div class="post-grid">{englishPosts.filter(post => post.id !== featured?.id).map(post => <PostCard post={post} />)}</div></section>
    <section id="latest" aria-labelledby="latest-heading"><div class="section-heading"><div><p class="eyebrow">读懂工具，也练习提问与思考</p><h2 id="latest-heading">延伸阅读</h2></div><a class="text-link" href="/archives/">全部文章 →</a></div><div class="post-grid">{latest.map(post => <PostCard post={post} />)}</div></section>
  </div><aside class="journal-sidebar">
    <section class="author-note"><span class="note-mark" aria-hidden="true">学</span><p class="eyebrow">你好，这里是纸间微光</p><h2>让 AI 成为<br />英语练习的帮手。</h2><p>这里整理 AI 英语工具的使用思路、可复制的提示模板和练习步骤。词汇、口语、阅读与写作，从一个具体问题开始，做完再回看。</p><a class="text-link" href="/about/">了解这本学习手记 →</a><div class="note-stats"><div><strong>{posts.length}</strong><span>篇手记</span></div><div><strong>{categories.length}</strong><span>个栏目</span></div></div></section>
    <section class="reading-path"><p class="eyebrow">今天，先练一点</p><h2>一条英语学习路线</h2><ol><li><a href="/posts/ai-vocabulary-cards/">先积累：把生词整理成卡片</a></li><li><a href="/posts/ai-speaking-scenes/">再开口：试一次情景对话</a></li><li><a href="/posts/ai-writing-feedback/">留下来：修改一段自己的英文</a></li></ol></section>
    <section class="sidebar-subscribe"><span aria-hidden="true">✳</span><h2>偶尔翻一翻</h2><p>用你喜欢的阅读器订阅，新的文字会顺着 RSS 抵达。</p><a href="/rss.xml">订阅纸间微光 ↗</a></section>
  </aside></div>
</Layout>
