FROM shiyue-reader-runtime:20260930-1

RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-saas.txt /tmp/requirements-saas.txt
RUN pip install --no-cache-dir -r /tmp/requirements-saas.txt
COPY deployment/docker/pdf_ocr_linux.py /opt/shiyue/pdf_ocr
RUN chmod 755 /opt/shiyue/pdf_ocr

WORKDIR /app
ENV PYTHONUNBUFFERED=1
CMD ["python3","tools/reader_server.py"]
